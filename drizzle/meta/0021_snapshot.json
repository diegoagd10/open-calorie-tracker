      "checkConstraints": {
        "food_entries_provider_check": {
          "name": "food_entries_provider_check",
          "value": "\"food_entries\".\"provider\" IN ('usda-fdc', 'open-food-facts', 'manual', 'ai-photo')"
        },
        "food_entries_data_type_check": {
          "name": "food_entries_data_type_check",
          "value": "\"food_entries\".\"source_data_type\" IN ('Branded', 'Survey (FNDDS)', 'Foundation', 'Open Food Facts', 'User entered', 'AI analysis')"
        },
        "food_entries_units_check": {
          "name": "food_entries_units_check",
          "value": "\"food_entries\".\"authoritative_base_unit\" IN ('g', 'ml', 'serving')\n        AND \"food_entries\".\"selected_measurement_unit\" IN ('g', 'ml', 'serving')"
        },
        "food_entries_provider_semantics_check": {
          "name": "food_entries_provider_semantics_check",
          "value": "(\"food_entries\".\"provider\" = 'usda-fdc'\n          AND \"food_entries\".\"source_data_type\" IN ('Branded', 'Survey (FNDDS)', 'Foundation')\n          AND \"food_entries\".\"authoritative_base_unit\" IN ('g', 'ml')\n          AND \"food_entries\".\"selected_measurement_unit\" IN ('g', 'ml'))\n        OR (\"food_entries\".\"provider\" = 'open-food-facts'\n          AND \"food_entries\".\"source_data_type\" = 'Open Food Facts'\n          AND \"food_entries\".\"selected_measurement_unit\" = \"food_entries\".\"authoritative_base_unit\"\n          AND ((\"food_entries\".\"authoritative_base_unit\" = 'serving' AND \"food_entries\".\"authoritative_base_quantity_microunits\" = 1000000)\n            OR (\"food_entries\".\"authoritative_base_unit\" IN ('g', 'ml') AND \"food_entries\".\"authoritative_base_quantity_microunits\" > 0)))\n        OR (\"food_entries\".\"provider\" = 'manual'\n          AND \"food_entries\".\"source_data_type\" = 'User entered'\n          AND \"food_entries\".\"authoritative_base_unit\" = 'serving'\n          AND \"food_entries\".\"selected_measurement_unit\" = 'serving')\n        OR (\"food_entries\".\"provider\" = 'ai-photo'\n          AND \"food_entries\".\"source_data_type\" = 'AI analysis'\n          AND \"food_entries\".\"authoritative_base_unit\" = 'serving'\n          AND \"food_entries\".\"selected_measurement_unit\" = 'serving')"
        },
        "food_entries_positive_quantities_check": {
          "name": "food_entries_positive_quantities_check",
          "value": "\"food_entries\".\"authoritative_base_quantity_microunits\" > 0\n        AND \"food_entries\".\"selected_measurement_base_quantity_microunits\" > 0\n        AND \"food_entries\".\"quantity_microunits\" > 0"
        }
      }
