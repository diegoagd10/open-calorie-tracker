        "food_events_units_check": {
          "name": "food_events_units_check",
          "value": "\"food_events\".\"authoritative_base_unit\" IN ('g', 'ml', 'serving')\n        AND \"food_events\".\"selected_measurement_unit\" IN ('g', 'ml', 'serving')"
