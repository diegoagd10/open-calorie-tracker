PORT=3001
DATABASE_URL=file:./data/sqlite.db
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=open-calorie-tracker-api
JWT_AUDIENCE=open-calorie-tracker-web
# Encrypts the stored API keys (at least 32 characters). Changing it makes existing keys unreadable
API_KEY_SECRET=change-me-to-another-long-random-secret
# Express "trust proxy" value, needed to read the client IP behind a reverse proxy
TRUST_PROXY=loopback
# Names the app and a contact to Open Food Facts, which looks products up by barcode
OPEN_FOOD_FACTS_USER_AGENT=OpenCalorieTracker/0.0.1 (https://github.com/diegoagd10/open-calorie-tracker)
# Optional: defaults to https://world.openfoodfacts.org
# OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
# Development user, only read by `pnpm --filter api db:seed` (never by the API itself)
SEED_USER_USERNAME=demo
SEED_USER_PASSWORD=demo-password
