PORT=3001
DATABASE_URL=file:./data/sqlite.db
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=open-calorie-tracker-api
JWT_AUDIENCE=open-calorie-tracker-web
# Express "trust proxy" value, needed to read the client IP behind a reverse proxy
TRUST_PROXY=loopback
# Max login requests per IP per minute
LOGIN_RATE_LIMIT=10
SEED_USER_USERNAME=demo
SEED_USER_PASSWORD=demo-password
