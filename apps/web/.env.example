# Backend API, called server-side by the route handlers
API_URL=http://localhost:3001
# Must match the API's JWT settings: the proxy checks the session token before serving a page
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=open-calorie-tracker-api
JWT_AUDIENCE=open-calorie-tracker-web
# Comma-separated hosts besides localhost that may use `next dev`, e.g. to test on a phone
ALLOWED_DEV_ORIGINS=
