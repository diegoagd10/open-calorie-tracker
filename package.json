{
  "name": "open-calory-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.7 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.13.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "admin:recover": "node build/recovery/recover-administrator.js",
    "catalog:import:off": "node build/catalog-command/import-catalog.js open-food-facts",
    "catalog:import:usda": "node build/catalog-command/import-catalog.js usda-fdc",
    "architecture": "pnpm architecture:check && pnpm architecture:test",
    "architecture:check": "fallow dead-code --baseline fallow-baselines/dead-code.json --fail-on-issues",
    "architecture:test": "node --test scripts/fallow-architecture.test.mjs",
    "auth:calibrate": "node scripts/calibrate-argon2.mjs",
    "audit:full": "node scripts/audit-dependencies.mjs",
    "audit:policy": "node --test scripts/audit-dependencies.test.mjs",
    "audit:prod": "pnpm audit --prod",
    "build": "react-router build && vite build --config vite.recovery.config.ts && vite build --config vite.catalog.config.ts && vite build --config vite.catalog-command.config.ts",
    "codeql:policy": "node --test scripts/check-codeql-results.test.mjs",
    "db:generate": "drizzle-kit generate",
    "dev": "NODE_ENV=development node --conditions development server.js",
    "fallow:audit": "fallow audit",
    "fallow:dead-code": "fallow dead-code --baseline fallow-baselines/dead-code.json --fail-on-issues",
    "fallow:dupes": "fallow dupes --baseline fallow-baselines/dupes.json --fail-on-issues",
    "fallow:full": "pnpm fallow:dead-code && pnpm fallow:dupes && pnpm fallow:health",
    "fallow:health": "fallow health --coverage coverage/coverage-final.json --baseline fallow-baselines/health.json --baseline-mode identity --fail-on-issues",
    "health": "pnpm test:coverage && pnpm health:report && pnpm health:test && pnpm health:check",
    "health:check": "fallow health --coverage coverage/coverage-final.json --baseline fallow-baselines/health.json --baseline-mode identity --fail-on-issues",
    "health:report": "fallow health --coverage coverage/coverage-final.json --report-only",
    "health:test": "node --test scripts/fallow-health.test.mjs",
    "lint": "pnpm lint:check && pnpm architecture",
    "lint:check": "eslint . --max-warnings 0 && pnpm lint:policy",
    "lint:ci": "eslint . --max-warnings 0 --format json",
    "lint:policy": "node --test scripts/eslint-policy.test.mjs",
    "start": "NODE_ENV=production node server.js",
    "test": "vitest run",
    "test:browser": "playwright test && playwright test --config playwright.catalog.config.ts",
    "test:browser:catalog": "playwright test --config playwright.catalog.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:properties": "vitest run tests/domain-properties.test.ts",
    "test:properties:deep": "PROPERTY_TEST_RUNS=10000 vitest run tests/domain-properties.test.ts",
    "typecheck": "react-router typegen && tsc -b",
    "verify": "pnpm typecheck && pnpm lint:check && pnpm test && pnpm fallow:audit && pnpm audit:prod",
    "verify:deep": "pnpm verify && pnpm test:coverage && pnpm fallow:full && pnpm architecture:test && pnpm health:test && pnpm test:browser && pnpm test:properties:deep && pnpm audit:policy && pnpm audit:full && pnpm codeql:policy && pnpm pr:policy",
    "test:photo-live": "PHOTO_ANALYSIS_LIVE=1 vitest run tests/photo-analysis.live.test.ts",
    "pr:check": "node scripts/pr.mjs check",
    "pr:create": "node scripts/pr.mjs create",
    "pr:policy": "node --test scripts/pr.test.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@react-router/express": "8.3.1",
    "@react-router/node": "8.3.1",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "better-sqlite3": "13.0.3",
    "compression": "1.8.1",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "isbot": "5.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "yauzl": "^3.4.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/react-test-renderer": "19.1.0",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fallow": "3.20.0",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "react-test-renderer": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
