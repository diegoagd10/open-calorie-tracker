{
  "name": "food-ingredient-extractor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "node src/extract-ingredients.js",
    "setup-key": "node src/setup-api-key.js",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --outDir dist --noEmit false",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/cli.ts migrate",
    "backup": "tsx src/cli.ts backup",
    "test": "tsx --test test/*.test.ts test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.5",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "openai": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.17.0"
}
