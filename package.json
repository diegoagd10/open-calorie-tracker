{
  "name": "open-calory-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.7 <25"
  },
  "scripts": {
    "auth:calibrate": "node scripts/calibrate-argon2.mjs",
    "audit:full": "node scripts/audit-dependencies.mjs",
    "audit:policy": "node --test scripts/audit-dependencies.test.mjs",
    "audit:prod": "pnpm audit --prod",
    "build": "react-router build",
    "codeql:policy": "node --test scripts/check-codeql-results.test.mjs",
    "db:generate": "drizzle-kit generate",
    "dev": "NODE_ENV=development node --conditions development server.js",
    "lint": "eslint . --max-warnings 0 && node --test scripts/eslint-policy.test.mjs",
    "lint:ci": "eslint . --max-warnings 0 --format json",
    "lint:policy": "node --test scripts/eslint-policy.test.mjs",
    "start": "NODE_ENV=production node server.js",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:deployment": "RUN_DEPLOYMENT_TESTS=1 vitest run tests/deployment.container.test.ts",
    "test:usda-live": "FDC_LIVE_SPIKE=1 vitest run tests/usda-catalog.live.test.ts",
    "typecheck:usda": "tsc -p tsconfig.usda.json",
    "typecheck": "react-router typegen && tsc -b"
  },
  "dependencies": {
    "@react-router/express": "8.3.1",
    "@react-router/node": "8.3.1",
    "better-sqlite3": "13.0.3",
    "compression": "1.8.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "isbot": "5.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/eslint-plugin": "1.6.27",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fallow": "3.20.0",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
