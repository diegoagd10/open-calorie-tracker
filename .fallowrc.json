      { "name": "browser-auth", "patterns": ["app/auth/**/*.client.ts"] },
      {
        "name": "auth",
        "patterns": [
          "app/auth/**",
          "app/auth.module.css",
          "scripts/argon2-profile.d.mts",
          "scripts/argon2-profile.mjs"
        ]
      },
      {
        "name": "catalog",
        "patterns": ["app/catalog/**"]
