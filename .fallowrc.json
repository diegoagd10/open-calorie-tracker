    "rules": [
      {
        "from": "web",
        "allow": [
          "auth",
          "browser-auth",
          "catalog",
          "catalog-management",
          "database",
          "photo-analysis",
          "food-entry",
          "food-log",
          "goals",
          "server",
          "setup",
          "water-event",
          "appearance"
