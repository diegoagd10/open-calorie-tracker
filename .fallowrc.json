      },
      { "from": "auth", "allow": ["database", "server"] },
      { "from": "appearance", "allow": [], "allowTypeOnly": ["web"] },
      { "from": "browser-auth", "allow": [] },
      { "from": "catalog", "allow": ["server", "database", "catalog-management"] },
      { "from": "database", "allow": [], "allowTypeOnly": ["catalog", "catalog-management"] },
