      {
        "name": "water-event",
        "patterns": ["app/water-event/**"]
      },
      {
        "name": "server",
        "patterns": ["server.js", "server/**", "app/runtime.server.ts"]
      },
      {
        "name": "tests",
        "patterns": ["tests/**", "scripts/**/*.test.mjs"]
      },
      {
        "name": "tooling",
        "patterns": [
          "drizzle.config.ts",
          "eslint.config.js",
          "playwright.config.ts",
          "playwright.catalog.config.ts",
