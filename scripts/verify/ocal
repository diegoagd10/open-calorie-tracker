class Stop extends Error {}

let writeJson = (value) => {
  process.stdout.write(`${JSON.stringify(value, null, 2)}\n`)
}

const emit = (value) => {
  writeJson(value)
}

const fail = (error, next, extra = {}) => {
  emit({ ok: false, error, next, ...extra })
  process.exitCode = 1
  throw new Stop()
}

const note = (message) => {
  process.stderr.write(`${message}\n`)
}

const envOr = (name, fallback) => {
  const value = process.env[name]
  return value === undefined || value === '' ? fallback : value
}

const flag = (flags, name) => flags[name] !== undefined

const parseArgs = (argv) => {
  const positional = []
  const flags = {}
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index]
    if (arg === '--') {
      positional.push(...argv.slice(index + 1))
      break
    }
    if (!arg.startsWith('--')) {
      positional.push(arg)
      continue
    }
    const key = arg.slice(2)
    const next = argv[index + 1]
    const value = next === undefined || next.startsWith('--') ? true : next
    if (value !== true) index += 1
    if (flags[key] === undefined) flags[key] = value
    else if (Array.isArray(flags[key])) flags[key].push(value)
    else flags[key] = [flags[key], value]
  }
  return { positional, flags }
}

const requirePort = (label, raw) => {
  const port = Number(raw)
  if (!Number.isInteger(port) || port < 1024 || port > 65535) {
    fail(
      `${label} must be an integer from 1024 to 65535.`,
      `Set ${label} to a free port in that range. The defaults are OCAL_WEB_PORT=${DEFAULT_WEB_PORT} and OCAL_API_PORT=${DEFAULT_API_PORT}.`,
    )
  }
  return port
}

const requireSecret = (name, value) => {
  if (value.length < 32) {
    fail(
      `${name} must be at least 32 characters.`,
      `Unset ${name} to use the local test default, or set it to a string of at least 32 characters.`,
    )
  }
}

const config = () => {
  const webPort = requirePort('OCAL_WEB_PORT', envOr('OCAL_WEB_PORT', String(DEFAULT_WEB_PORT)))
  const apiPort = requirePort('OCAL_API_PORT', envOr('OCAL_API_PORT', String(DEFAULT_API_PORT)))
  if (webPort === apiPort) {
    fail(
      'OCAL_WEB_PORT and OCAL_API_PORT are the same.',
      'Give the web app and the API different ports. The defaults are 3410 and 3411.',
    )
  }
  const runDir = resolve(envOr('OCAL_RUN_DIR', join(tmpdir(), `ocal-verify-${webPort}`)))
  assertSafeRunDir(runDir)
  if (evidenceDir === runDir || evidenceDir.startsWith(`${runDir}${sep}`)) {
    fail(
      'OCAL_EVIDENCE_DIR is inside the run directory.',
      'Keep evidence at artifacts/verify (the default) or another path down does not delete.',
    )
  }
  const jwtSecret = envOr('JWT_SECRET', DEFAULT_JWT_SECRET)
  const apiKeySecret = envOr('API_KEY_SECRET', DEFAULT_API_KEY_SECRET)
  requireSecret('JWT_SECRET', jwtSecret)
  requireSecret('API_KEY_SECRET', apiKeySecret)
  const skipSeed = envOr('OCAL_SKIP_SEED', '') === '1' || envOr('OCAL_SKIP_SEED', '') === 'true'
  return {
    webPort,
    apiPort,
    webUrl: `http://127.0.0.1:${webPort}`,
    apiUrl: `http://127.0.0.1:${apiPort}`,
    runDir,
    dataDir: join(runDir, 'data'),
    logDir: join(runDir, 'logs'),
    databasePath: join(runDir, 'data', 'sqlite.db'),
    skipSeed,
    seedUsername: envOr('SEED_USER_USERNAME', DEFAULT_SEED_USERNAME),
    seedPassword: envOr('SEED_USER_PASSWORD', DEFAULT_SEED_PASSWORD),
    seedPasswordSource:
      process.env['SEED_USER_PASSWORD'] === undefined || process.env['SEED_USER_PASSWORD'] === ''
        ? 'default'
        : 'SEED_USER_PASSWORD',
    jwtSecret,
    jwtIssuer: envOr('JWT_ISSUER', 'open-calorie-tracker-api'),
    jwtAudience: envOr('JWT_AUDIENCE', 'open-calorie-tracker-web'),
    apiKeySecret,
    userAgent: envOr('OPEN_FOOD_FACTS_USER_AGENT', DEFAULT_USER_AGENT),
    usingDefaultJwt: process.env['JWT_SECRET'] === undefined || process.env['JWT_SECRET'] === '',
  }
}

const assertSafeRunDir = (runDir) => {
