const loadPlaywright = async () => {
  const file = join(webDir, 'node_modules/playwright/index.mjs')
  if (!existsSync(file)) {
    fail(
      'Playwright is not installed in apps/web.',
      'Run `pnpm install` and `pnpm --filter web exec playwright install chromium` from the checkout.',
    )
  }
