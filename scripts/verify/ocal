const sleep = (ms) => new Promise((resolvePromise) => setTimeout(resolvePromise, ms))

const fetchJson = async (url, init) => {
  const response = await fetch(url, init)
  const text = await response.text()
  let body
  try {
    body = text === '' ? null : JSON.parse(text)
  } catch {
    body = text
  }
  return { status: response.status, body }
}

const loginSeed = async (cfg) => {
  const result = await fetchJson(`${cfg.apiUrl}/v1/login`, {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ username: cfg.seedUsername, password: cfg.seedPassword }),
  })
  if (result.status !== 200 || typeof result.body?.accessToken !== 'string') {
    fail(
      `Login as "${cfg.seedUsername}" failed with status ${result.status}.`,
      'Check SEED_USER_USERNAME and SEED_USER_PASSWORD. They must be the values used at `ocal up`. Then run `./scripts/verify/ocal seed` or `./scripts/verify/ocal down` and `./scripts/verify/ocal up`.',
      { status: result.status, body: result.body },
    )
  }
  return result.body.accessToken
}

