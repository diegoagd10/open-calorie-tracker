}

const browserPaths = (run) => ({
  dir: join(run.runDir, 'browser'),
  storage: join(run.runDir, 'browser', 'storage-state.json'),
  page: join(run.runDir, 'browser', 'page.json'),
  socket: join(run.runDir, 'browser', 'daemon.sock'),
  pid: join(run.runDir, 'browser', 'daemon.json'),
  log: join(run.runDir, 'browser', 'daemon.log'),
})

const browserLocator = (page, flags, prefix) => {
  const roleKey = prefix === '' ? 'role' : `${prefix}role`
  const nameKey = prefix === '' ? 'name' : `${prefix}name`
  const exactKey = prefix === '' ? 'exact' : `${prefix}exact`
  const textKey = prefix === '' ? 'text' : `${prefix}text`
  if (flag(flags, textKey)) return page.getByText(String(flags[textKey]), { exact: flag(flags, exactKey) })
  if (!flag(flags, roleKey)) {
    fail(
      'This browser command needs --role or --text.',
      'Example: `./scripts/verify/ocal browser click --role button --name "Add food"`.',
    )
  }
  const options = {}
  if (flag(flags, nameKey)) options.name = String(flags[nameKey])
  if (flag(flags, exactKey)) options.exact = true
  return page.getByRole(String(flags[roleKey]), options)
}

const scoped = (page, flags) => {
  if (!flag(flags, 'within-role') && !flag(flags, 'within-text')) return page
  return browserLocator(page, {
    role: flags['within-role'],
    name: flags['within-name'],
    exact: flags['within-exact'],
    text: flags['within-text'],
  }, '')
}

const describeTarget = (flags) => {
  if (flag(flags, 'text')) return `text "${flags.text}"`
  const name = flag(flags, 'name') ? ` name "${flags.name}"` : ''
  return `role ${flags.role ?? '(missing)'}${name}`
}

const socketUp = (socketPath) =>
  new Promise((resolvePromise) => {
    const socket = createConnection(socketPath)
    const done = (up) => {
      socket.removeAllListeners()
      socket.destroy()
      resolvePromise(up)
    }
    socket.once('connect', () => done(true))
    socket.once('error', () => done(false))
  })

const stopBrowserDaemon = (run) => {
  const paths = browserPaths(run)
  if (!existsSync(paths.pid)) return null
  const { pid } = JSON.parse(readFileSync(paths.pid, 'utf8'))
  return { pid, result: Number.isInteger(pid) ? killPid(pid) : 'missing' }
}

const ensureBrowserDaemon = async (cfg, run) => {
  const paths = browserPaths(run)
  if (await socketUp(paths.socket)) return
  mkdirSync(paths.dir, { recursive: true })
  rmSync(paths.socket, { force: true })
  const log = openSync(paths.log, 'a')
  const child = spawn(process.execPath, [fileURLToPath(import.meta.url), 'browser-daemon'], {
    cwd: repoRoot,
    env: process.env,
    detached: true,
    stdio: ['ignore', log, log],
  })
  child.unref()
  closeSync(log)
  writeFileSync(paths.pid, `${JSON.stringify({ pid: child.pid })}\n`)
  for (let attempt = 0; attempt < 50; attempt += 1) {
    if (await socketUp(paths.socket)) return
    if (!alive(child.pid)) break
    await sleep(100)
  }
  fail(
    'The browser process exited before it accepted commands.',
    `Read ${paths.log}. Install Chromium with \`pnpm --filter web exec playwright install chromium\` if it is missing, then retry the browser command.`,
  )
}

const browserRequest = async (cfg, payload) => {
  const run = readRun(cfg)
  await ensureBrowserDaemon(cfg, run)
  const paths = browserPaths(run)
  const response = await new Promise((resolvePromise, reject) => {
    const socket = createConnection(paths.socket)
    let buf = ''
    socket.on('data', (chunk) => {
      buf += chunk.toString('utf8')
      const newline = buf.indexOf('\n')
      if (newline === -1) return
      try {
        resolvePromise(JSON.parse(buf.slice(0, newline)))
      } catch (error) {
        reject(error)
      }
      socket.end()
    })
    socket.on('error', reject)
    socket.on('connect', () => socket.write(`${JSON.stringify(payload)}\n`))
  }).catch((error) => {
    fail(
      `The browser process did not answer (${error instanceof Error ? error.message : String(error)}).`,
      'Run `./scripts/verify/ocal browser reset` and retry the command. `down` also closes that process.',
    )
  })
  emit(response)
  if (response?.ok !== true) process.exitCode = 1
}

const saveBrowser = async (context, page, paths) => {
  mkdirSync(paths.dir, { recursive: true })
  await context.storageState({ path: paths.storage })
  writeFileSync(paths.page, `${JSON.stringify({ url: page.url() })}\n`)
}

const browserDaemon = async (cfg) => {
  const run = readRun(cfg)
  const paths = browserPaths(run)
  mkdirSync(paths.dir, { recursive: true })
  const { chromium } = await loadPlaywright()
  const browser = await chromium.launch()
  const context = await browser.newContext({
    viewport: { width: 1280, height: 900 },
    colorScheme: 'light',
    ...(existsSync(paths.storage) ? { storageState: paths.storage } : {}),
  })
  const page = await context.newPage()
  page.setDefaultTimeout(15000)
  if (existsSync(paths.page)) {
    const saved = JSON.parse(readFileSync(paths.page, 'utf8'))
    if (typeof saved.url === 'string' && saved.url !== 'about:blank') {
      await page.goto(saved.url, { waitUntil: 'domcontentloaded' }).catch(() => {})
    }
  }
  rmSync(paths.socket, { force: true })
  let chain = Promise.resolve()
  const answer = (socket, value) => {
    if (!socket.writableEnded) socket.end(`${JSON.stringify(value)}\n`)
  }
  const server = createServer((socket) => {
    let buf = ''
    socket.on('data', (chunk) => {
      buf += chunk.toString('utf8')
      const newline = buf.indexOf('\n')
      if (newline === -1) return
      const line = buf.slice(0, newline)
      buf = buf.slice(newline + 1)
      chain = chain.then(async () => {
        const stdout = writeJson
        let sent = false
        writeJson = (value) => {
          sent = true
          answer(socket, value)
        }
        try {
          const request = JSON.parse(line)
          const timeout = request.flags?.timeout === undefined ? 15000 : Number(request.flags.timeout)
          page.setDefaultTimeout(Number.isInteger(timeout) && timeout > 0 ? timeout : 15000)
          await runBrowserAction(page, run, request.action, request.args ?? [], request.flags ?? {})
        } catch (error) {
          if (!sent) {
            const message = error instanceof Error ? error.message : String(error)
            answer(socket, {
              ok: false,
              error: message,
              next: 'Retry the browser command. If the page is stuck, run `./scripts/verify/ocal browser reset`.',
            })
          }
        } finally {
          writeJson = stdout
          await saveBrowser(context, page, paths).catch(() => {})
        }
      })
    })
  })
  await new Promise((resolvePromise, reject) => {
    server.once('error', reject)
    server.listen(paths.socket, () => resolvePromise())
  })
  await new Promise(() => {})
}

const requireOne = async (locator, flags) => {
  const count = await locator.count()
  if (count !== 1) {
    fail(
      `${count} elements matched ${describeTarget(flags)}.`,
      'Add --exact, a longer --name, or --within-role and --within-name so one element matches. Prefer a role and accessible name over a CSS selector.',
    )
  }
}

const browser = async (cfg, positional, flags, dryRun) => {
  const action = positional[0]
  const mutating = ['open', 'click', 'fill', 'press', 'reset'].includes(action)
  if (dryRun && mutating) {
    emit({ ok: true, dryRun: true, would: action, args: positional.slice(1), flags })
    return
  }
  if (action === 'reset') {
    const run = readRun(cfg)
    const daemon = stopBrowserDaemon(run)
    rmSync(browserPaths(run).dir, { recursive: true, force: true })
    emit({ ok: true, reset: true, runDir: run.runDir, daemon })
    return
  }
  const timeout = flags.timeout === undefined ? 15000 : Number(flags.timeout)
  if (!Number.isInteger(timeout) || timeout < 1) {
    fail('--timeout must be a positive number of milliseconds.', 'Example: `--timeout 20000`.')
  }
  await browserRequest(cfg, { action, args: positional.slice(1), flags })
}

const runBrowserAction = async (page, run, action, positional, flags) => {
    if (action === 'open') {
      const target = positional[0]
      if (typeof target !== 'string') {
        fail(
          'browser open needs a path.',
          'Example: `./scripts/verify/ocal browser open /login`.',
        )
      }
      const url = target.startsWith('http') ? target : `${run.webUrl}${target.startsWith('/') ? '' : '/'}${target}`
      let parsed
      try {
        parsed = new URL(url)
      } catch {
        fail('That URL is not valid.', 'Pass a path such as /login or /weight.')
      }
      if (parsed.origin !== run.webUrl) {
        fail(
          `Refusing to open ${parsed.origin}.`,
          `This run serves ${run.webUrl}. Pass a path on that origin, for example /login.`,
        )
      }
      await page.goto(url, { waitUntil: 'domcontentloaded' })
      emit({ ok: true, url: page.url() })
      return
    }
    if (action === 'url') {
      if (page.url() === 'about:blank') {
        fail('No browser page has been opened.', 'Run `./scripts/verify/ocal browser open /login` first.')
      }
      emit({ ok: true, url: page.url() })
      return
    }
    if (action === 'snapshot') {
      if (!flag(flags, 'aria')) {
        fail(
          'browser snapshot needs --aria.',
          'Example: `./scripts/verify/ocal browser snapshot --aria --path artifacts/verify/log-food/list.aria.txt`.',
        )
      }
      const snapshot = await page.ariaSnapshot()
      if (flag(flags, 'path')) {
        const path = resolve(repoRoot, String(flags.path))
        mkdirSync(dirname(path), { recursive: true })
        writeFileSync(path, snapshot)
      }
      emit({ ok: true, url: page.url(), path: flags.path ?? null, snapshot })
      return
    }
    if (action === 'screenshot') {
      if (!flag(flags, 'path')) {
        fail(
          'browser screenshot needs --path.',
          'Example: `./scripts/verify/ocal browser screenshot --path artifacts/verify/log-food/list.png`.',
        )
      }
      const path = resolve(repoRoot, String(flags.path))
      mkdirSync(dirname(path), { recursive: true })
      await page.screenshot({ path, fullPage: true })
      emit({ ok: true, url: page.url(), path })
      return
    }
    const root = scoped(page, flags)
    const locator = browserLocator(root, flags, '')
    if (action === 'wait') {
      await locator.waitFor({ state: flags.state === undefined ? 'visible' : String(flags.state) })
      emit({ ok: true, url: page.url(), state: flags.state ?? 'visible', target: describeTarget(flags) })
      return
    }
    if (action === 'click' || action === 'fill' || action === 'press' || action === 'text') {
      await requireOne(locator, flags)
    }
    if (action === 'click') {
      await locator.click()
      if (flag(flags, 'wait-role') || flag(flags, 'wait-text')) {
        const waitRoot = flag(flags, 'wait-within-role') || flag(flags, 'wait-within-text')
          ? browserLocator(page, {
              role: flags['wait-within-role'],
              name: flags['wait-within-name'],
              exact: flags['wait-within-exact'],
              text: flags['wait-within-text'],
            }, '')
          : page
        await browserLocator(waitRoot, {
          role: flags['wait-role'],
          name: flags['wait-name'],
          exact: flags['wait-exact'],
          text: flags['wait-text'],
        }, '').waitFor()
      }
      emit({ ok: true, url: page.url(), clicked: describeTarget(flags) })
      return
    }
    if (action === 'fill') {
      if (!flag(flags, 'value')) {
        fail('browser fill needs --value.', 'Example: `--role textbox --name Food --value Oatmeal`.')
      }
      await locator.fill(String(flags.value))
      emit({ ok: true, url: page.url(), filled: describeTarget(flags) })
      return
    }
    if (action === 'press') {
      if (!flag(flags, 'key')) {
        fail('browser press needs --key.', 'Example: `--key Enter`.')
      }
      await locator.press(String(flags.key))
      emit({ ok: true, url: page.url(), pressed: flags.key })
      return
    }
    if (action === 'text') {
      let value = null
      try {
        value = await locator.inputValue()
      } catch {
        value = null
      }
      const text = (value ?? (await locator.textContent()) ?? '').trim()
      const disabled = await locator.isDisabled().catch(() => false)
      emit({ ok: true, url: page.url(), text, value, disabled, target: describeTarget(flags) })
      return
    }
    fail(
      `Unknown browser command "${action ?? ''}".`,
      'Use open, click, fill, press, wait, text, snapshot, screenshot, url, or reset. Run `./scripts/verify/ocal --help`.',
    )
}

const main = async () => {
  if (typeof nodeCrypto.argon2 !== 'function') {
    fail(
      `Node.js 26 is required because the API imports argon2 from node:crypto. This process is ${process.version}.`,
      'Install Node 26 (the Dockerfile uses node:26) and run `./scripts/verify/ocal` with that `node` first on PATH.',
    )
  }
  process.chdir(repoRoot)
  if (!existsSync(join(repoRoot, 'pnpm-workspace.yaml'))) {
    fail(
      `No pnpm workspace at ${repoRoot}.`,
      'Run ./scripts/verify/ocal from a checkout of open-calorie-tracker.',
    )
  }
  const { positional, flags } = parseArgs(process.argv.slice(2))
  if (flag(flags, 'help') || positional.length === 0 || positional[0] === 'help') {
    process.stdout.write(HELP)
    return
  }
  const [command, ...rest] = positional
  const dryRun = flag(flags, 'dry-run')
  const cfg = config()
  if (command === 'up') return up(cfg, dryRun)
  if (command === 'down') return down(cfg, dryRun)
  if (command === 'doctor') return doctor(cfg)
  if (command === 'seed') return seed(cfg, dryRun)
  if (command === 'call') return call(cfg, rest, flags, dryRun)
  if (command === 'logs') return logs(cfg, rest, flags)
  if (command === 'db') return db(cfg, flags)
  if (command === 'test') return test(dryRun)
  if (command === 'browser') return browser(cfg, rest, flags, dryRun)
  if (command === 'browser-daemon') return browserDaemon(cfg)
  fail(
    `Unknown command "${command}".`,
    'Run `./scripts/verify/ocal --help` for up, doctor, seed, call, logs, db, test, down, and browser.',
  )
}

process.on('SIGINT', () => {
  stopForeground()
  process.exit(130)
})
process.on('SIGTERM', () => {
  stopForeground()
  process.exit(143)
})

await main().catch((error) => {
  if (error instanceof Stop) return
  emit({
    ok: false,
    error: error instanceof Error ? error.message : String(error),
    next: 'Run `./scripts/verify/ocal --help` and retry the command. If a stack is half-started, run `./scripts/verify/ocal down`.',
  })
  process.exitCode = 1
})
