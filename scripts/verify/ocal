const call = async (cfg, positional, flags, dryRun) => {
  const run = readRun(cfg)
  const method = String(positional[0] ?? '').toUpperCase()
  const path = positional[1]
  if (!['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'HEAD'].includes(method) || typeof path !== 'string') {
    fail(
      'call needs an HTTP method and a path.',
      'Example: `./scripts/verify/ocal call GET /v1/health` or `./scripts/verify/ocal call GET /v1/settings/profile --auth`.',
    )
  }
  if (!path.startsWith('/') || path.startsWith('//')) {
    fail(
      'The path must start with a single /.',
      'Pass an API path such as /v1/daily-log?date=2026-11-20&timeZone=America/New_York. The host is this run\'s API.',
    )
  }
  const url = `${run.apiUrl}${path}`
  const headers = { accept: 'application/json' }
  if (flag(flags, 'body')) {
    try {
      JSON.parse(String(flags.body))
    } catch {
      fail(
        '--body is not JSON.',
        'Pass a JSON object, for example --body \'{"username":"demo","password":"demo-password"}\'.',
      )
    }
    headers['content-type'] = 'application/json'
  }
  const request = { method, url, auth: flag(flags, 'auth'), body: flag(flags, 'body') ? flags.body : undefined }
  if (dryRun) {
    emit({ ok: true, dryRun: true, wouldSend: request })
    return
  }
  if (flag(flags, 'auth')) {
    if (run.skipSeed) {
      fail(
        'This run has no seed user to authenticate as.',
        'Start with seeding (unset OCAL_SKIP_SEED) or pass --body with credentials you registered.',
      )
    }
    const token = await loginSeed({ ...cfg, apiUrl: run.apiUrl, seedUsername: run.seedUsername })
    headers.authorization = `Bearer ${token}`
  }
  const result = await fetchJson(url, { method, headers, body: request.body })
  const ok = result.status >= 200 && result.status < 300
  emit({ ok, ...result, url, method })
  if (!ok) process.exitCode = 1
}

const logs = (cfg, positional, flags) => {
  const run = readRun(cfg)
  const lines = flags.lines === undefined ? 120 : Number(flags.lines)
  if (!Number.isInteger(lines) || lines < 1) {
    fail('--lines must be a positive integer.', 'Example: `./scripts/verify/ocal logs api --lines 80`.')
  }
  const requested = positional[0] === undefined ? ['api', 'web'] : [positional[0]]
  if (requested.some((service) => service !== 'api' && service !== 'web')) {
    fail(
      'logs accepts api, web, or no service.',
      'Example: `./scripts/verify/ocal logs` or `./scripts/verify/ocal logs web --lines 80`.',
    )
  }
  const body = {}
  for (const service of requested) {
    body[service] = tail(join(run.logDir, `${service}.log`), lines)
  }
  emit({ ok: true, lines, logs: body })
}

const db = (cfg, flags) => {
  const run = readRun(cfg)
  const sql = flags.sql
  if (typeof sql !== 'string' || sql.trim() === '') {
    fail(
      'db needs --sql.',
      'Example: `./scripts/verify/ocal db --sql "SELECT name, calories FROM food_entries"`.',
    )
  }
  const statement = sql.trim().replace(/;+\s*$/, '')
  if (!/^select\b/i.test(statement) || statement.includes(';')) {
    fail(
      'db only runs a single SELECT.',
      'Pass one SELECT. down deletes the database; this command does not modify it.',
    )
  }
  const require = createRequire(join(apiDir, 'package.json'))
  const { createClient } = require('@libsql/client')
  const client = createClient({ url: `file:${run.databasePath}`, intMode: 'number' })
  return client
    .execute(statement)
    .then((result) => {
      client.close()
      emit({
        ok: true,
        databasePath: run.databasePath,
        columns: result.columns,
        rows: result.rows,
      })
    })
    .catch((error) => {
      client.close()
      fail(
        error instanceof Error ? error.message : String(error),
        'Check the table names in apps/api/src/db/schema.ts. food_entries, water_entries, weight_entries, and daily_goals are the user-facing ones.',
      )
    })
}

