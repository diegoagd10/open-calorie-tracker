const alive = (pid) => Number.isInteger(pid) && pid > 1 && existsSync(`/proc/${pid}`)

const ancestors = (pid) => {
  const seen = new Set()
  let current = pid
  while (Number.isInteger(current) && current > 1 && !seen.has(current)) {
    seen.add(current)
    let stat
    try {
      stat = readFileSync(`/proc/${current}/stat`, 'utf8')
    } catch {
      break
    }
    const match = stat.match(/\)\s+\S+\s+(\d+)/)
    current = match ? Number(match[1]) : 0
  }
  return seen
}

const listeningPids = (port) => {
  const hex = port.toString(16).toUpperCase().padStart(4, '0')
  const inodes = new Set()
  for (const file of ['/proc/net/tcp', '/proc/net/tcp6']) {
    if (!existsSync(file)) continue
    for (const line of readFileSync(file, 'utf8').trim().split('\n').slice(1)) {
      const parts = line.trim().split(/\s+/)
      const localPort = parts[1]?.split(':').at(-1)?.toUpperCase()
      if (parts[3] === '0A' && localPort === hex) inodes.add(parts[9])
    }
  }
  if (inodes.size === 0) return []
  const pids = []
  for (const entry of readdirSync('/proc')) {
    if (!/^\d+$/.test(entry)) continue
    let fds
    try {
      fds = readdirSync(`/proc/${entry}/fd`)
    } catch {
      continue
    }
    for (const fd of fds) {
      try {
        const target = readlinkSync(`/proc/${entry}/fd/${fd}`)
        const match = /^socket:\[(\d+)\]$/.exec(target)
        if (match && inodes.has(match[1])) pids.push(Number(entry))
      } catch {
        // The fd can vanish while we read it.
      }
    }
  }
  return [...new Set(pids)]
}

const ownsPort = (pid, port) => {
  const listeners = listeningPids(port)
  return listeners.some((listener) => listener === pid || ancestors(listener).has(pid))
}

const tail = (path, lines) => {
  if (!existsSync(path)) return ''
  return readFileSync(path, 'utf8').split('\n').slice(-lines).join('\n').trim()
}

let foreground = null

const runForeground = (command, args, { cwd = repoRoot, env = process.env, logPath } = {}) =>
  new Promise((resolvePromise) => {
    mkdirSync(dirname(logPath), { recursive: true })
    const log = openSync(logPath, 'w')
    const child = spawn(command, args, { cwd, env, stdio: ['ignore', 'pipe', 'pipe'] })
    foreground = child
    const chunks = []
    const capture = (chunk) => {
      chunks.push(chunk)
      writeFileSync(log, chunk, { flag: 'a' })
    }
    child.stdout.on('data', capture)
    child.stderr.on('data', capture)
    child.on('close', (code) => {
      foreground = null
      closeSync(log)
      const output = Buffer.concat(chunks).toString('utf8')
      resolvePromise({ code: code ?? 1, output, logPath })
    })
  })

const stopForeground = () => {
  if (foreground === null || foreground.exitCode !== null) return
  try {
    process.kill(-foreground.pid, 'SIGTERM')
  } catch {
    try {
      foreground.kill('SIGTERM')
    } catch {
      // Already gone.
    }
  }
}

const startService = (service, command, args, cwd, env, logDir) => {
  mkdirSync(logDir, { recursive: true })
  const logPath = join(logDir, `${service}.log`)
  const log = openSync(logPath, 'a')
  const child = spawn(command, args, {
    cwd,
    env,
    detached: true,
    stdio: ['ignore', log, log],
  })
  child.unref()
  closeSync(log)
  if (!Number.isInteger(child.pid)) {
    fail(`Failed to start ${service}.`, `Read ${logPath}, then run ./scripts/verify/ocal up again.`)
  }
  return child.pid
}

const killPid = (pid) => {
  if (!alive(pid)) return 'dead'
  try {
    process.kill(-pid, 'SIGTERM')
  } catch {
    try {
      process.kill(pid, 'SIGTERM')
    } catch {
      return 'dead'
    }
  }
  const deadline = Date.now() + 5000
  while (Date.now() < deadline && alive(pid)) {
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 100)
  }
  if (!alive(pid)) return 'stopped'
  try {
    process.kill(-pid, 'SIGKILL')
  } catch {
    try {
      process.kill(pid, 'SIGKILL')
    } catch {
      return 'dead'
    }
  }
  return alive(pid) ? 'still-running' : 'killed'
}

