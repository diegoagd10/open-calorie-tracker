    )
  }
  const parts = runDir.split(sep).filter(Boolean)
  if (parts.length < 2) {
    fail(
      'Refusing to use a run directory that close to the filesystem root.',
      'Set OCAL_RUN_DIR to a dedicated directory such as /tmp/ocal-verify-3410.',
    )
