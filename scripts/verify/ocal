const pageMarker = (cfg) => (cfg.skipSeed ? 'Create account' : 'Log in')

const assertRendered = async (cfg) => {
  const { chromium } = await loadPlaywright()
  const browser = await chromium.launch()
  try {
    const page = await browser.newPage({ viewport: { width: 1280, height: 900 } })
    const path = cfg.skipSeed ? '/register' : '/login'
    await page.goto(`${cfg.webUrl}${path}`, { waitUntil: 'domcontentloaded' })
    await page.getByRole('heading', { name: pageMarker(cfg) }).waitFor({ timeout: 20000 })
    await page.getByText('Open Calorie Tracker').waitFor({ timeout: 5000 })
  } finally {
    await browser.close()
  }
}

const waitUntilUsable = async (cfg) => {
  const deadline = Date.now() + 90000
  let last = 'no response yet'
  while (Date.now() < deadline) {
    if (!alive(cfg.pids.api) || !alive(cfg.pids.web)) {
      fail(
        'A server exited before it became usable.',
        'The log tails are in this JSON. Fix the cause and run `./scripts/verify/ocal up` again. This attempt was stopped and its data directory was removed.',
        {
          apiAlive: alive(cfg.pids.api),
          webAlive: alive(cfg.pids.web),
          apiLog: tail(join(cfg.logDir, 'api.log'), 40),
          webLog: tail(join(cfg.logDir, 'web.log'), 40),
        },
      )
    }
    try {
      const health = await fetchJson(`${cfg.apiUrl}/v1/health`)
      const setup = await fetchJson(`${cfg.apiUrl}/v1/setup`)
      const page = await fetch(`${cfg.webUrl}${cfg.skipSeed ? '/register' : '/login'}`)
      const html = await page.text()
      const healthOk = health.status === 200 && health.body?.status === 'ok'
      const setupOk = setup.status === 200 && setup.body?.needsSetup === cfg.skipSeed
      const pageOk = page.status === 200 && html.includes(pageMarker(cfg))
      if (healthOk && setupOk && pageOk) {
        await assertRendered(cfg)
        if (cfg.skipSeed) {
          return { health: health.body, setup: setup.body, page: pageMarker(cfg), auth: null }
        }
        const login = await fetchJson(`${cfg.apiUrl}/v1/login`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ username: cfg.seedUsername, password: cfg.seedPassword }),
        })
        const token = login.body?.accessToken
        const profile =
          login.status === 200 && typeof token === 'string'
            ? await fetchJson(`${cfg.apiUrl}/v1/settings/profile`, {
                headers: { authorization: `Bearer ${token}` },
              })
            : { status: login.status, body: login.body }
        if (profile.status === 200 && profile.body?.username === cfg.seedUsername.toLowerCase()) {
          return {
            health: health.body,
            setup: setup.body,
            page: pageMarker(cfg),
            auth: { username: profile.body.username },
          }
        }
        last = `login ${login.status}, profile ${profile.status}`
      } else {
        last = `health ${health.status}, setup ${setup.status}, page ${page.status}`
      }
    } catch (error) {
      if (error instanceof Stop) throw error
      last = error instanceof Error ? error.message : String(error)
    }
    await sleep(500)
  }
  fail(
    `The stack did not become usable within 90s (${last}).`,
    'The log tails are in this JSON. Fix the cause and run `./scripts/verify/ocal up` again. This attempt was stopped and its data directory was removed.',
    {
      apiLog: tail(join(cfg.logDir, 'api.log'), 40),
      webLog: tail(join(cfg.logDir, 'web.log'), 40),
    },
  )
}

const occupied = (port) => {
  const pids = listeningPids(port)
  if (pids.length === 0) return
  fail(
    `Port ${port} is already in use by pid ${pids.join(', ')}.`,
    'Choose a free OCAL_WEB_PORT and OCAL_API_PORT, and a matching OCAL_RUN_DIR. Do not stop a process by name; it may belong to another run.',
  )
}

const up = async (cfg, dryRun) => {
  requirePnpm()
  requireInstall()
  if (existsSync(runFile(cfg))) {
    fail(
      `A run is already recorded at ${cfg.runDir}.`,
      'Run `./scripts/verify/ocal down` before starting another one on these ports. For a second stack, set OCAL_WEB_PORT, OCAL_API_PORT, and OCAL_RUN_DIR.',
    )
  }
  occupied(cfg.webPort)
  occupied(cfg.apiPort)
  if (dryRun) {
    emit({ ok: true, dryRun: true, would: 'build, migrate, seed, and start', ...plan(cfg) })
    return
  }
  mkdirSync(cfg.dataDir, { recursive: true })
  mkdirSync(cfg.logDir, { recursive: true })
  const tree = snapshotTree()
  await build(cfg, 'shared', ['--filter', '@open-calorie-tracker/shared', 'build'])
  await build(cfg, 'api', ['--filter', 'api', 'build'])
  if (!cfg.skipSeed) {
    note('seeding')
    const seeded = await runForeground(process.execPath, ['dist/seed.js'], {
      cwd: apiDir,
      env: { ...serviceEnv(cfg), NODE_ENV: 'development' },
      logPath: join(cfg.logDir, 'seed.log'),
    })
    if (seeded.code !== 0) {
      rmSync(cfg.runDir, { recursive: true, force: true })
      fail(
        'Seeding failed.',
        'The database was removed. Fix SEED_USER_USERNAME and SEED_USER_PASSWORD (the password must be at least 8 letters or numbers), then run `./scripts/verify/ocal up` again.',
        { tail: seeded.output.split('\n').slice(-30).join('\n') },
      )
    }
  }
  note('starting api')
  const apiPid = startService(
    'api',
    process.execPath,
    ['dist/main.js'],
    apiDir,
    serviceEnv(cfg),
    cfg.logDir,
  )
  note('building web')
  const webBuild = await runForeground('pnpm', ['--filter', 'web', 'exec', 'next', 'build'], {
    env: baseEnv({ NEXT_DIST_DIR: distDirName, NEXT_TELEMETRY_DISABLED: '1' }),
    logPath: join(cfg.logDir, 'build-web.log'),
  }).catch(async (error) => {
    killPid(apiPid)
    throw error
  })
  if (webBuild.code !== 0) {
    killPid(apiPid)
    rmSync(cfg.runDir, { recursive: true, force: true })
    fail(
      'The web build failed.',
      'Read the log tail, fix the build, then run `./scripts/verify/ocal up` again. The API was stopped.',
      { tail: webBuild.output.split('\n').slice(-40).join('\n') },
    )
  }
  const buildIdPath = join(webDir, distDirName, 'BUILD_ID')
  if (!existsSync(buildIdPath) || !existsSync(join(apiDir, 'dist/main.js'))) {
    killPid(apiPid)
    rmSync(cfg.runDir, { recursive: true, force: true })
    fail(
      'The build did not produce dist/main.js and a Next BUILD_ID.',
      'Run `pnpm --filter api build` and `NEXT_DIST_DIR=.next-ocal pnpm --filter web exec next build` by hand to see the error, then `./scripts/verify/ocal up`.',
    )
  }
  note('starting web')
  const webPid = startService(
    'web',
    process.execPath,
    [
      join(webDir, 'node_modules/next/dist/bin/next'),
      'start',
      '--port',
      String(cfg.webPort),
      '--hostname',
      '127.0.0.1',
    ],
    webDir,
    baseEnv({
      PORT: String(cfg.webPort),
      API_URL: cfg.apiUrl,
      JWT_SECRET: cfg.jwtSecret,
      JWT_ISSUER: cfg.jwtIssuer,
      JWT_AUDIENCE: cfg.jwtAudience,
      NEXT_DIST_DIR: distDirName,
      NEXT_TELEMETRY_DISABLED: '1',
      NODE_ENV: 'production',
    }),
    cfg.logDir,
  )
  const run = {
    ...plan(cfg),
    ...tree,
    apiMainSha256: sha256(join(apiDir, 'dist/main.js')),
    webBuildId: readFileSync(buildIdPath, 'utf8').trim(),
    startedAt: new Date().toISOString(),
    pids: { api: apiPid, web: webPid },
  }
  writeRun(cfg, run)
  try {
    const ready = await waitUntilUsable({ ...cfg, pids: run.pids })
    emit({ ok: true, ready, ...publicRun(run) })
  } catch (error) {
    if (error instanceof Stop) {
      killPid(apiPid)
      killPid(webPid)
      rmSync(cfg.runDir, { recursive: true, force: true })
    }
    throw error
  }
}

const down = (cfg, dryRun) => {
  if (!existsSync(runFile(cfg))) {
    if (dryRun) {
      emit({
        ok: true,
        dryRun: true,
        would: 'do nothing',
        runDir: cfg.runDir,
        keep: evidenceDir,
      })
      return
    }
    fail(
      `No run is recorded at ${cfg.runDir}.`,
      'Nothing was stopped. If something is still listening, it was not started by ocal. Set OCAL_RUN_DIR to the run you want to stop.',
    )
  }
  const run = readRun(cfg)
  const daemonPid = existsSync(browserPaths(run).pid)
    ? JSON.parse(readFileSync(browserPaths(run).pid, 'utf8')).pid
    : null
  const actions = ['api', 'web'].map((service) => ({
    service,
    pid: run.pids?.[service] ?? null,
    alive: alive(run.pids?.[service]),
  }))
  actions.push({ service: 'browser', pid: daemonPid, alive: alive(daemonPid) })
  if (dryRun) {
    emit({
      ok: true,
      dryRun: true,
      wouldStop: actions,
      wouldRemove: cfg.runDir,
      keep: evidenceDir,
    })
    return
  }
  const stopped = actions.map((action) => ({
    ...action,
    result: action.pid === null ? 'missing' : killPid(action.pid),
  }))
  const stuck = stopped.filter((action) => action.result === 'still-running')
  if (stuck.length > 0) {
    fail(
      `Could not stop pid ${stuck.map((action) => action.pid).join(', ')}.`,
      'Those pids are the ones recorded for this run. Inspect them in /proc and stop those pids only, then run `./scripts/verify/ocal down` again. The evidence directory was not touched.',
      { stopped, keep: evidenceDir },
    )
  }
  rmSync(cfg.runDir, { recursive: true, force: true })
  emit({ ok: true, stopped, removed: cfg.runDir, keep: evidenceDir })
}

const buildMatches = (run) => {
  const apiMain = join(apiDir, 'dist/main.js')
  const buildIdPath = join(webDir, distDirName, 'BUILD_ID')
  const tree = snapshotTree()
  const problems = []
  if (!existsSync(apiMain) || sha256(apiMain) !== run.apiMainSha256) {
    problems.push('apps/api/dist/main.js')
  }
  if (!existsSync(buildIdPath) || readFileSync(buildIdPath, 'utf8').trim() !== run.webBuildId) {
    problems.push(`apps/web/${distDirName}/BUILD_ID`)
  }
  if (tree.gitSha !== run.gitSha || tree.dirty !== run.dirty) {
    problems.push('git checkout')
  }
  return { ok: problems.length === 0, problems, gitSha: tree.gitSha }
}

const doctor = async (cfg) => {
  const run = readRun(cfg)
  const processes = {}
  for (const [service, port] of [
    ['api', run.apiPort],
    ['web', run.webPort],
  ]) {
    const pid = run.pids?.[service]
    const cwd = alive(pid) ? readlinkSync(`/proc/${pid}/cwd`) : null
    processes[service] = {
      pid,
      alive: alive(pid),
      cwd,
      ownsPort: alive(pid) && ownsPort(pid, port),
      port,
    }
  }
  const build = buildMatches(run)
  let health = null
  let auth = null
  let page = null
  const errors = []
  if (!processes.api.alive || !processes.web.alive) {
    errors.push('A recorded process is not running.')
  }
  if (processes.api.alive && !processes.api.ownsPort) {
    errors.push(`Nothing this run started is listening on ${run.apiUrl}.`)
  }
  if (processes.web.alive && !processes.web.ownsPort) {
    errors.push(`Nothing this run started is listening on ${run.webUrl}.`)
  }
  if (!build.ok) errors.push(`The checkout no longer matches this run (${build.problems.join(', ')}).`)
  if (errors.length === 0) {
    health = await fetchJson(`${run.apiUrl}/v1/health`)
    if (health.status !== 200 || health.body?.status !== 'ok') {
      errors.push(`GET /v1/health returned ${health.status}.`)
    }
    const path = run.skipSeed ? '/register' : '/login'
    const response = await fetch(`${run.webUrl}${path}`)
    const html = await response.text()
    page = { path, status: response.status, rendered: html.includes(pageMarker(run)) }
    if (response.status !== 200 || !page.rendered) {
      errors.push(`${path} did not render ${pageMarker(run)}.`)
    }
    if (!run.skipSeed) {
      try {
        const token = await loginSeed({ ...cfg, apiUrl: run.apiUrl, seedUsername: run.seedUsername })
        const profile = await fetchJson(`${run.apiUrl}/v1/settings/profile`, {
          headers: { authorization: `Bearer ${token}` },
        })
        auth = {
          valid: profile.status === 200 && profile.body?.username === run.seedUsername.toLowerCase(),
          username: profile.body?.username ?? null,
        }
        if (!auth.valid) errors.push('The seed user could not open /v1/settings/profile.')
      } catch (error) {
        if (error instanceof Stop) throw error
        errors.push(error instanceof Error ? error.message : String(error))
      }
    }
  }
  const body = {
    ok: errors.length === 0,
    ...publicRun(run),
    processes,
    build,
    health: health?.body ?? null,
    page,
    auth,
    errors,
  }
  if (errors.length > 0) {
    fail(
      errors.join(' '),
      'Run `./scripts/verify/ocal logs` if a process is unhealthy. Run `./scripts/verify/ocal down` and then `./scripts/verify/ocal up` so this checkout is the one that is serving.',
      body,
    )
  }
  emit(body)
}

